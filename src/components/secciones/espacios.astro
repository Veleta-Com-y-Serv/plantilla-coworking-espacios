---
// Espacios en zigzag a sangre: cada espacio es una fila 50/50 a todo el ancho con la foto tocando el borde de la
// ventana y su ficha al lado (número, capacidad, nombre, texto, qué incluye, precio y botón). El destacado lleva
// la ficha en carbón. Lista `espacios` (nombre, texto, precio, periodo, capacidad, incluye «;», imagen,
// destacado). Sin precio no hay precio; sin espacios se ve la cabecera con el botón.
import { seccion, valores, indice } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const espacios = s ? s.espacios.filter((e) => e.nombre) : [];
const total = String(espacios.length).padStart(2, '0');
---

{
  s && (
    <section id={id} class="banda--clara">
      <div class="contenedor seccion">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {espacios.length === 0 && s.cta?.url && <a class="btn mt-10" href={s.cta.url}>{s.cta.texto}</a>}
      </div>
      {espacios.length > 0 && (
        <ol class="border-t border-texto/15">
          {espacios.map((e, i) => (
            <li class="grid border-b border-texto/15 md:grid-cols-2">
              <div class:list={['relative aspect-[4/3] overflow-hidden md:aspect-auto md:min-h-[34rem]', i % 2 === 1 && 'md:order-2']}>
                <Imagen
                  src={e.imagen || '/placeholders/espacio.svg'}
                  respaldo="/placeholders/espacio.svg"
                  alt={altFicha(e)}
                  ancho={1200}
                  alto={900}
                  class="absolute inset-0 h-full w-full object-cover"
                />
                {e.destacado && <span class="mono absolute left-4 top-4 bg-[var(--c-acento)] px-3 py-1.5 text-xs font-bold uppercase tracking-[.14em] text-[var(--sobre-acento)] md:left-8 md:top-8">Destacado</span>}
              </div>
              <div class:list={['flex flex-col justify-center px-4 py-12 md:px-10 md:py-16 lg:px-20', e.destacado ? 'banda--oscura' : i % 2 ? 'banda--blanca' : 'banda--clara']}>
                <div class="w-full max-w-[38rem]">
                  <p class="mono flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-semibold uppercase tracking-[.14em]">
                    <span><span class="punto">{indice(i)}</span> / {total}</span>
                    {e.capacidad && (
                      <span class="inline-flex items-center gap-2 opacity-80">
                        <Icono nombre="usuarios" tam={16} />
                        {e.capacidad}
                      </span>
                    )}
                  </p>
                  <h3 class="mt-5 text-[clamp(2rem,4.2vw,3.6rem)]">{e.nombre}</h3>
                  {e.texto && <p class="mt-4 text-lg opacity-85">{e.texto}</p>}
                  {valores(e.incluye).length > 0 && (
                    <ul class="mt-7 grid gap-x-6 gap-y-2.5 sm:grid-cols-2">
                      {valores(e.incluye).map((v) => (
                        <li class="flex gap-2.5 text-[.95rem]">
                          <Icono nombre="check" tam={18} class="mt-0.5 shrink-0 text-[var(--c-acento)]" />
                          <span>{v}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {(e.precio || s.cta?.url) && (
                    <div class="mt-9 flex flex-wrap items-end justify-between gap-6 border-t border-current/20 pt-6">
                      {e.precio && (
                        <p class="leading-none">
                          <span class="text-[clamp(1.9rem,3.4vw,2.8rem)] font-extrabold tracking-tight">{e.precio}</span>
                          {e.periodo && <span class="mono ml-2 text-sm opacity-75">{e.periodo}</span>}
                        </p>
                      )}
                      {s.cta?.url && <a class="enlace-flecha" href={s.cta.url}>{s.cta.texto}</a>}
                    </div>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      )}
    </section>
  )
}
