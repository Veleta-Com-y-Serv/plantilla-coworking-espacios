---
// Preguntas frecuentes: banda de carbón con el título enorme a la izquierda (fijo al hacer scroll en escritorio)
// y un acordeón nativo <details> a la derecha, sin JavaScript. Campos: `preguntas[]` (pregunta, respuesta).
// Sin preguntas no se pinta. También sirve de diseño para apartados nuevos (`tipo: preguntas`).
import { seccion, indice } from '../../data/site';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <section id={id} class="banda--oscura plano seccion">
      <div class="contenedor grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            {s.antetitulo && <p class="rotulo">{s.antetitulo}</p>}
            {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
            {s.texto && <p class="titular-texto mt-6">{s.texto}</p>}
          </div>
        </div>
        <div class="border-b border-current/20 lg:col-span-7">
          {preguntas.map((p, i) => (
            <details class="faq border-t border-current/20">
              <summary class="flex min-h-[3.5rem] items-start gap-4 py-6 md:gap-6">
                <span class="mono mt-1.5 text-xs font-semibold text-[var(--c-acento)]" aria-hidden="true">{indice(i)}</span>
                <span class="flex-1 text-xl font-bold leading-snug tracking-tight md:text-2xl">{p.pregunta}</span>
                <span class="faq-signo grid h-9 w-9 shrink-0 place-items-center bg-[var(--c-acento)] text-xl font-bold leading-none text-[var(--sobre-acento)]" aria-hidden="true">+</span>
              </summary>
              {p.respuesta && <p class="pb-7 pl-8 pr-4 text-lg opacity-80 md:pl-12 md:pr-14">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
