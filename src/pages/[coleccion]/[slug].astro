---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /espacios/<slug>/.
// Diseño urbano a sangre, como el zigzag de la portada: fila 50/50 con migas, rótulo mono, título enorme, precio y
// botones a un lado y la foto tocando el borde al otro (sin foto, el icono en grande sobre carbón); banda blanca con
// el `detalle` y la tabla de datos con la caja de visita en carbón; fotos (`imagenes`) en banda clara a sangre; y
// otros espacios en retícula con filetes, esquinas rectas.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const visita = seccion('visita') ? enlace('/#visita') : site.boton_cabecera?.url || enlace('/#contacto');
const textoVisita = seccion('visita') ? 'Pide una visita' : site.boton_cabecera?.texto || 'Pide una visita';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const capacidad = f.datos.find((d) => d.clave === 'capacidad')?.valor ?? '';
const datos = f.datos.filter((d) => d.clave !== 'precio' && d.clave !== 'periodo');
const periodo = f.datos.find((d) => d.clave === 'periodo')?.valor ?? '';
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda--clara ficha-cabeza">
    <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
      <div class="ficha-hero-texto">
        <nav aria-label="Migas de pan" class="migas">
          <ol>
            {migas.map((m, i) => (
              <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
            ))}
          </ol>
        </nav>
        <p class="rotulo mt-10">{f.categoria || f.def.nombre}</p>
        <h1 class="titulo-seccion">{f.titulo}</h1>
        {f.texto && <p class="titular-texto">{f.texto}</p>}
        {(capacidad || f.precio) && (
          <p class="ficha-chips mono">
            {capacidad && <span class="inline-flex items-center gap-2"><Icono nombre="usuarios" tam={18} /> {capacidad}</span>}
            {f.precio && (
              <span class="ficha-precio">{f.precio}{periodo && <span class="ficha-periodo"> {periodo}</span>}</span>
            )}
          </p>
        )}
        <div class="ficha-botones">
          <a class="btn" href={visita}>{textoVisita}</a>
          {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
        </div>
      </div>
      {f.imagen ? (
        <div class="ficha-foto">
          <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="absolute inset-0 h-full w-full object-cover" />
        </div>
      ) : (
        <div class="ficha-icono banda--oscura" aria-hidden="true"><Icono nombre={f.icono || 'sala'} tam={110} /></div>
      )}
    </div>
  </section>

  <section class="banda--blanca seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {datos.length > 0 && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo mono">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}{periodo && ` ${periodo}`}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-visita banda--oscura">
          <p class="ficha-visita-titulo">¿Quieres verlo en persona?</p>
          <p class="opacity-85">Te enseñamos la nave, probamos el espacio y resolvemos tus dudas sin compromiso.</p>
          <a class="btn" href={visita}>{textoVisita}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda--clara" aria-label={`Fotos de ${f.titulo}`}>
      <ul class="ficha-galeria">
        {f.imagenes.map((src, i) => (
          <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
        ))}
      </ul>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda--clara seccion">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo={`Otros ${nombreSeccion.toLowerCase()}`} />
        <ul class="ficha-otras">
          {otras.map((o, i) => (
            <li class="ficha-otra">
              <p class="mono ficha-otra-n"><span class="punto">{String(i + 1).padStart(2, '0')}</span> / {String(otras.length).padStart(2, '0')}</p>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p class="opacity-80">{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Ver todos los {nombreSeccion.toLowerCase()}</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-hero { display: grid; }
  .ficha-hero-texto { padding: 1.5rem 1rem 3rem; min-width: 0; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.3rem, 6vw, 4.6rem); overflow-wrap: anywhere; }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .85rem; font-weight: 650; font-family: var(--fuente-mono); text-transform: uppercase; letter-spacing: .08em; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "/"; opacity: .5; }
  .migas a { color: inherit; text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; border-bottom: 2px solid transparent; }
  .migas a:hover { border-bottom-color: var(--c-acento); }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-chips { display: flex; flex-wrap: wrap; align-items: baseline; gap: .75rem 1.5rem; margin-top: 1.5rem; font-size: .9rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; }
  .ficha-precio { font-family: var(--fuente-titulos); font-weight: 800; font-size: 1.6rem; letter-spacing: -.02em; text-transform: none; }
  .ficha-periodo { font-family: var(--fuente-mono); font-size: .8rem; font-weight: 500; opacity: .75; letter-spacing: .05em; text-transform: uppercase; }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-foto { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-fondo); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.3rem; font-weight: 500; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 1rem; }
  .ficha-datos { border: 2px solid var(--c-texto); padding: 1.5rem; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid color-mix(in srgb, var(--c-texto) 20%, transparent); }
  .ficha-datos dt { font-family: var(--fuente-mono); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-datos dd.ficha-precio { font-size: 1.2rem; }
  .ficha-visita { display: grid; gap: .9rem; padding: 1.75rem 1.5rem; justify-items: start; }
  .ficha-visita-titulo { font-family: var(--fuente-titulos); font-size: 1.6rem; font-weight: 800; line-height: 1.1; letter-spacing: -.02em; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 750; color: inherit; text-decoration: none; border-bottom: 2px solid var(--c-acento); }
  .ficha-galeria { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; }
  .ficha-otras { display: grid; gap: 0; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); margin-top: 2.5rem; border-top: 1px solid color-mix(in srgb, var(--c-texto) 20%, transparent); border-left: 1px solid color-mix(in srgb, var(--c-texto) 20%, transparent); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.75rem 1.5rem; border-right: 1px solid color-mix(in srgb, var(--c-texto) 20%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--c-texto) 20%, transparent); transition: background-color .2s ease; }
  .ficha-otra:hover { background: color-mix(in srgb, var(--c-acento) 14%, transparent); }
  .ficha-otra-n { font-size: .75rem; font-weight: 600; letter-spacing: .14em; }
  .ficha-otra h3 { font-size: 1.6rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; overflow-wrap: anywhere; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-acento); outline-offset: -3px; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .75rem; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 750; border-bottom: 2px solid var(--c-acento); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 38rem; }
    .ficha-hero-texto { padding: 2rem 4rem 4rem 5rem; align-self: center; max-width: 52rem; }
    .ficha-foto, .ficha-icono { aspect-ratio: auto; min-height: 100%; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>